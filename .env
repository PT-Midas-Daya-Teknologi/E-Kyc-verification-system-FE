# Leave empty — Vite proxy forwards /api/* to http://localhost:8080
VITE_API_BASE_DOMAIN=http://localhost:8080
VITE_API_BASE_URL=${VITE_API_BASE_DOMAIN}/openapi/dev

# AWS Region — MUST match Spring Boot aws.region
VITE_AWS_REGION=ap-south-1

# Python E-KYC frame WebSocket (E-Kyc-verification-system-BE-Python)
VITE_WEBSOCKET_URL=ws://localhost:8000/ws
